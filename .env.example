# Database (Turso / libSQL)
# Leave both unset for local dev — the app falls back to a local SQLite file at ./data/meetings.db.
# For production (e.g. Vercel), set these to a Turso database — see README for setup steps.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Anthropic (Claude) — used for meeting analysis + follow-up chat
ANTHROPIC_API_KEY=

# Optional: override the default models (both default to claude-opus-4-8)
ANTHROPIC_ANALYSIS_MODEL=claude-opus-4-8
ANTHROPIC_CHAT_MODEL=claude-opus-4-8

# Groq — used for audio transcription (Whisper)
GROQ_API_KEY=

# Optional: override the default transcription model
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
